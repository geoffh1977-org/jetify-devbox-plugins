{
  "name": "zsh-environment",
  "description": "Base shell and utility packages for Devbox environments.",
  "create_files": {
    "{{ .DevboxDir }}/setup-devbox.sh": "scripts/setup-devbox.sh",
    "{{ .DevboxDir }}/zsh-config.sh": "scripts/zsh-config.sh"
  },
  "packages": [
    "zsh@latest",
    "zsh-autosuggestions@latest",
    "zsh-syntax-highlighting@latest",
    "bat@latest",
    "dust@latest",
    "eza@latest",
    "less@latest",
    "p7zip@latest",
    "jq@latest",
    "starship@latest",
    "tmux@latest",
    "powerline@latest",
    "powerline-fonts@latest",
    "vim@latest"
  ],
  "shell": {
    "init_hook": [
      "chmod +x {{ .DevboxDir }}/setup-devbox.sh",
      "chmod +x {{ .DevboxDir }}/zsh-config.sh",
      "source {{ .DevboxDir }}/setup-devbox.sh",
      "source {{ .DevboxDir }}/zsh-config.sh"
    ]
  }
}
